# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/haango

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
RESET_TOKEN_EXPIRY_MINUTES=15
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_COOKIE_NAME=haango_access_token
REFRESH_COOKIE_NAME=haango_refresh_token

# Email SMTP (for OTP/password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=no-reply@haango.app

# Frontend
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Razorpay (leave empty if not configured yet)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RazorpayX Payouts (separate from Checkout credentials)
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# Pricing
PLATFORM_FEE_PERCENTAGE=3
MIN_BOOKING_DURATION=1
MAX_BOOKING_DURATION=8
